{
  "name": "ngx-uswds-icons-demo",
  "version": "18.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run regenerateIcons && ng serve",
    "build": "npm run regenerateIcons && ng build",
    "build-prod": "npm run regenerateIcons && ng build ngx-uswds-icons --configuration production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && coverage-badges --source coverage/coverage-summary.json --output .github/badges/coverage.svg",
    "lint": "eslint .",
    "e2e": "playwright test",
    "regenerateIcons": "./scripts/copy-svgs.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:publish-workflow": "node scripts/validate-publish-workflow.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@angular/animations": "21.2.18",
    "@angular/common": "22.0.0",
    "@angular/compiler": "22.0.0",
    "@angular/core": "22.0.0",
    "@angular/forms": "22.0.0",
    "@angular/platform-browser": "22.0.0",
    "@angular/platform-browser-dynamic": "21.2.18",
    "@angular/router": "22.0.0",
    "lodash": "^4.17.21",
    "ngx-bootstrap-icons": "^1.9.2",
    "replace": "^1.2.1",
    "rxjs": "7.8.2",
    "svg-parser": "^2.0.4",
    "tslib": "^2.4.0",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.19",
    "@angular-eslint/eslint-plugin": "22.0.0",
    "@angular-eslint/eslint-plugin-template": "22.0.0",
    "@angular-eslint/template-parser": "22.0.0",
    "@angular/cli": "22.0.0",
    "@angular/compiler-cli": "22.0.0",
    "@playwright/test": "1.62.1",
    "@types/node": "25.9.2",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@typescript-eslint/utils": "8.65.0",
    "@vitest/coverage-v8": "4.1.8",
    "coverage-badges-cli": "2.2.0",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "ng-packagr": "22.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "uswds": "2.14.0",
    "vitest": "4.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.20.1": true,
    "fsevents@2.3.3": true,
    "nice-napi@1.0.2": true
  }
}
