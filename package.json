{
  "name": "ngx-uswds-icons-demo",
  "version": "18.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run regenerateIcons && ng serve",
    "build": "npm run regenerateIcons && ng build",
    "build-prod": "npm run regenerateIcons && ng build ngx-uswds-icons --configuration production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && coverage-badges --source coverage/coverage-summary.json --output .github/badges/coverage.svg",
    "lint": "eslint .",
    "e2e": "ng e2e",
    "regenerateIcons": "./scripts/copy-svgs.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "engines": {
    "node": ">=20.11.1 <21"
  },
  "dependencies": {
    "@angular/animations": "19.2.25",
    "@angular/common": "19.2.25",
    "@angular/compiler": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/forms": "19.2.25",
    "@angular/platform-browser": "19.2.25",
    "@angular/platform-browser-dynamic": "19.2.25",
    "@angular/router": "19.2.25",
    "lodash": "^4.17.21",
    "ngx-bootstrap-icons": "^1.9.2",
    "replace": "^1.2.1",
    "rxjs": "~6.6.0",
    "svg-parser": "^2.0.4",
    "tslib": "^2.4.0",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "uswds": "2.14.0",
    "@angular-devkit/build-angular": "19.2.27",
    "@angular-eslint/eslint-plugin": "19.8.1",
    "@angular-eslint/eslint-plugin-template": "19.8.1",
    "@angular-eslint/template-parser": "19.8.1",
    "@angular/cli": "19.2.27",
    "@angular/compiler-cli": "19.2.25",
    "@types/node": "20.17.57",
    "@typescript-eslint/eslint-plugin": "8.38.0",
    "@typescript-eslint/parser": "8.38.0",
    "@typescript-eslint/utils": "8.38.0",
    "@vitest/coverage-v8": "2.1.9",
    "coverage-badges-cli": "2.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "ng-packagr": "19.2.2",
    "prettier": "3.9.6",
    "typescript": "5.8.3",
    "vitest": "2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.20.1": true,
    "fsevents@2.3.3": true,
    "nice-napi@1.0.2": true
  }
}
