{
  "name": "ngx-uswds-icons-demo",
  "version": "17.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run regenerateIcons && ng serve",
    "build": "npm run regenerateIcons && ng build",
    "build-prod": "npm run regenerateIcons && ng build ngx-uswds-icons --configuration production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && coverage-badges --source coverage/coverage-summary.json --output .github/badges/coverage.svg",
    "lint": "eslint .",
    "e2e": "ng e2e",
    "regenerateIcons": "./scripts/copy-svgs.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "@angular/animations": "^20.1.8",
    "@angular/common": "^21.2.14",
    "@angular/compiler": "^21.2.14",
    "@angular/core": "^21.2.14",
    "@angular/forms": "^21.2.14",
    "@angular/platform-browser": "^21.2.14",
    "@angular/platform-browser-dynamic": "^20.0.7",
    "@angular/router": "^21.2.14",
    "lodash": "^4.17.21",
    "ngx-bootstrap-icons": "^1.9.2",
    "number-to-text": "^0.4.1",
    "replace": "^1.2.1",
    "rxjs": "~7.8.2",
    "svg-parser": "^2.0.4",
    "tslib": "^2.4.0",
    "uswds": "^2.11.2",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.12",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.14",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "@typescript-eslint/utils": "8.64.0",
    "@vitest/coverage-v8": "4.1.7",
    "coverage-badges-cli": "2.2.0",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "ng-packagr": "^21.2.3",
    "prettier": "3.9.6",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3",
    "vitest": "4.1.7"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.20.1": true,
    "fsevents@2.3.3": true,
    "nice-napi@1.0.2": true
  }
}
